# Public JARVIS GitHub URLs; these are not secrets.
# The app defaults to these verified project links if you don't override them.
VITE_GITHUB_REPO=https://github.com/ash4jarvis/jarvis
VITE_GITHUB_RELEASES_URL=https://github.com/ash4jarvis/jarvis/releases

# Never put API keys, tokens, or other private credentials in VITE_ variables;
# Vite includes them in the public website bundle.
